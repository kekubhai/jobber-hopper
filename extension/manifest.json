{
  "manifest_version": 3,
  "name": "AI Browser Agent",
  "description": "Detects job forms and email requests, asks the local AI backend for actions, and executes them in the browser.",
  "version": "1.0.0",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://localhost:3000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AI Browser Agent",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
